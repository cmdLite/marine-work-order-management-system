# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same four values as
# environment variables on Vercel / Netlify for the deployed app.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → anon / public key.
# Safe to expose: every request it makes is filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API Keys → service_role key.
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_. It bypasses RLS entirely
# and is used for exactly two things: minting a session for a pre-seeded
# backing account, and creating/updating the auth account behind a profile.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random string of 32+ characters. The credential for each hidden backing
# auth account is derived from this plus the account's email, so it is never
# stored anywhere. Changing it means you must re-run the seed.
#   openssl rand -base64 32
IMPERSONATION_SECRET=change-me-to-a-long-random-string
